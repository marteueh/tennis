# ╔═════════════════════════════════════════════════════════════════════╗
# ║                    Ace Chronicle — Variabili ambiente               ║
# ╠═════════════════════════════════════════════════════════════════════╣
# ║ Sviluppo locale: copia questo file in `.env.local` e compila.       ║
# ║ Produzione (Vercel): configura ogni variabile in                    ║
# ║   Project Settings → Environment Variables.                         ║
# ║ Non committare mai .env.local (è in .gitignore).                    ║
# ╚═════════════════════════════════════════════════════════════════════╝

# ── Database ───────────────────────────────────────────────────────────
# Locale (PostgreSQL installato su Windows/macOS/Linux):
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ace_chronicle

# Produzione (Neon — copia la connection string dal dashboard Neon):
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/ace_chronicle?sslmode=require

# ── YouTube Data API v3 ────────────────────────────────────────────────
# Crea un progetto su console.cloud.google.com, abilita "YouTube Data API v3"
# Quota gratuita: 10.000 unità/giorno
YOUTUBE_API_KEY=

# ── Google Custom Search (per cercare estratti Clerici) ────────────────
# Stessa chiave del progetto YouTube se abiliti "Custom Search API"
# Motore di ricerca: programmablesearchengine.google.com
GOOGLE_CSE_ID=

# ── Vercel Cron ─────────────────────────────────────────────────────────
# Stringa casuale che autentica le chiamate cron interne
# Genera con: openssl rand -base64 32
CRON_SECRET=

# ── Newsletter (Beehiiv) ───────────────────────────────────────────────
# ID pubblicazione Beehiiv (visibile nell'URL del dashboard)
NEXT_PUBLIC_BEEHIIV_PUBLICATION_ID=

# ── Google Tag Manager ─────────────────────────────────────────────────
# Container ID — formato GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Authentication (Auth.js / NextAuth v5) ─────────────────────────────
# Secret per firmare i cookie di sessione
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# URL pubblico del sito — in produzione usa il dominio completo (es. https://acechronicle.it)
AUTH_URL=http://localhost:3000

# ── SMTP per magic link Auth.js ─────────────────────────────────────────
# Credenziali del tuo provider email (Aruba, Register, OVH, ecc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Ace Chronicle <noreply@example.com>"

# ── hCaptcha (bot protection per registrazione) ─────────────────────────
# Registrati su https://hcaptcha.com (gratuito)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
